@{
    ViewData["Title"] = "AlmaVault Control Center";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <h2 class="h4 mb-0 text-primary fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>AlmaVault Control Center</h2>
            <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill">Admin Dashboard</span>
        </div>
        <form asp-controller="Admin" asp-action="AdminLogout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </div>

    <!-- Analytics & KPI Dashboard Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small fw-semibold text-uppercase mb-1">Pending Verifications</p>
                        <h3 class="fw-bold mb-0 text-dark">12</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-person-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small fw-semibold text-uppercase mb-1">Active Mentorships</p>
                        <h3 class="fw-bold mb-0 text-dark">48</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small fw-semibold text-uppercase mb-1">Total Registered Users</p>
                        <h3 class="fw-bold mb-0 text-dark">1,250</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-person-badge-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small fw-semibold text-uppercase mb-1">Upcoming Events</p>
                        <h3 class="fw-bold mb-0 text-dark">09</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom-0 pt-3 px-3">
            <ul class="nav nav-tabs card-header-tabs" id="adminTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-semibold" id="verification-tab" data-bs-toggle="tab" data-bs-target="#verification" type="button" role="tab">
                        <i class="bi bi-person-vcard me-1"></i> Alumni Verification Queue
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">
                        <i class="bi bi-sliders me-1"></i> User & Role Management
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" id="mentorship-tab" data-bs-toggle="tab" data-bs-target="#mentorship" type="button" role="tab">
                        <i class="bi bi-calendar2-check me-1"></i> Mentorship & Events Oversight
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="adminTabsContent">
                
                <!-- Tab 1: Alumni Verification Queue -->
                <div class="tab-pane fade show active" id="verification" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Pending Registration Approvals</h5>
                        <span class="text-muted small">Showing 12 pending requests</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Applicant</th>
                                    <th>Batch</th>
                                    <th>Roll Number</th>
                                    <th>Department</th>
                                    <th>Submitted Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Jane Doe</div>
                                        <div class="small text-muted">jane.d@example.com</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">2018-2022</span></td>
                                    <td><code>CS2018-042</code></td>
                                    <td>Computer Science</td>
                                    <td>Aug 06, 2026</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-info me-1" data-bs-toggle="modal" data-bs-target="#reviewModal">
                                            <i class="bi bi-eye"></i> Review Credentials
                                        </button>
                                        <form asp-controller="Admin" asp-action="ApproveAlumni" asp-route-id="101" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success me-1">Approve</button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="RejectAlumni" asp-route-id="101" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: User & Role Management -->
                <div class="tab-pane fade" id="users" role="tabpanel">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" placeholder="Search by name, email, or roll number..." id="userSearchInput" />
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="roleFilter">
                                <option value="">Filter by Role (All)</option>
                                <option value="Student">Student</option>
                                <option value="Alumni">Alumni</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="statusFilter">
                                <option value="">Filter by Status (All)</option>
                                <option value="Active">Active</option>
                                <option value="Suspended">Suspended</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Current Role</th>
                                    <th>Status</th>
                                    <th>Last Active</th>
                                    <th class="text-end">Manage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Alex Smith</div>
                                        <div class="small text-muted">alex.smith@alumni.org</div>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm w-auto d-inline">
                                            <option value="Student">Student</option>
                                            <option value="Alumni" selected>Alumni</option>
                                            <option value="Admin">Admin</option>
                                        </select>
                                    </td>
                                    <td><span class="badge bg-success">Active</span></td>
                                    <td>Today, 08:30 AM</td>
                                    <td class="text-end">
                                        <form asp-controller="Admin" asp-action="ToggleUserStatus" asp-route-id="202" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning me-1">Suspend</button>
                                        </form>
                                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editUserModal">Update Role</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Mentorship & Events Oversight -->
                <div class="tab-pane fade" id="mentorship" role="tabpanel">
                    <div class="row g-4">
                        <!-- Pending Mentorship Requests -->
                        <div class="col-lg-6">
                            <div class="card border border-light shadow-none">
                                <div class="card-header bg-light fw-bold">Pending Mentorship Requests</div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                            <div>
                                                <h6 class="mb-0 fw-semibold">Career Guidance: Cloud Engineering</h6>
                                                <small class="text-muted">Mentor: Dr. Alan Turing | Mentee: Mark Lee</small>
                                            </div>
                                            <div>
                                                <form asp-controller="Admin" asp-action="ApproveMentorship" asp-route-id="301" method="post" class="d-inline">
                                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                                                </form>
                                                <form asp-controller="Admin" asp-action="RejectMentorship" asp-route-id="301" method="post" class="d-inline">
                                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                                                </form>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Track Active Events & Webinars -->
                        <div class="col-lg-6">
                            <div class="card border border-light shadow-none">
                                <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
                                    <span>Active Events & Workshops</span>
                                    <span class="badge bg-primary">4 Active</span>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                            <div>
                                                <h6 class="mb-0 fw-semibold">AI/ML Career Webinar 2026</h6>
                                                <small class="text-muted">Posted by: Sarah Connor (Alumni) • Aug 15, 2026</small>
                                            </div>
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-menu-item dropdown-item" href="#">View Attendees</a></li>
                                                    <li><a class="dropdown-menu-item dropdown-item text-danger" href="#">Unpublish Event</a></li>
                                                </ul>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal: Review Submitted Credentials -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Review Applicant Credentials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Full Name</label>
                        <p class="fw-semibold">Jane Doe</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Roll Number</label>
                        <p class="fw-semibold">CS2018-042</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Graduation Batch</label>
                        <p class="fw-semibold">2018 - 2022</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Department</label>
                        <p class="fw-semibold">Computer Science & Engineering</p>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold">Degree Certificate / ID Proof</label>
                        <div class="border rounded p-3 text-center bg-light">
                            <i class="bi bi-file-earmark-pdf fs-1 text-danger"></i>
                            <p class="mb-2 mt-1 small">Degree_Certificate_JaneDoe.pdf</p>
                            <a href="#" class="btn btn-sm btn-outline-primary rounded-pill">View Document</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <form asp-controller="Admin" asp-action="RejectAlumni" asp-route-id="101" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Reject Request</button>
                </form>
                <form asp-controller="Admin" asp-action="ApproveAlumni" asp-route-id="101" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success btn-sm">Approve Alumni</button>
                </form>
            </div>
        </div>
    </div>
</div>