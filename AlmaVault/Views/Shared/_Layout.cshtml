@using Microsoft.AspNetCore.Identity
@inject SignInManager<AlmaVault.Models.Domains.ApplicationUser> SignInManager
@inject UserManager<AlmaVault.Models.Domains.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlmaVault</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlmaVault.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .navbar-glass {
            background: rgba(255, 255, 255, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .nav-link {
            font-weight: 500;
            color: #475569;
            transition: color 0.2s ease-in-out;
            padding: 0.5rem 0.85rem !important;
            border-radius: 8px;
        }

            .nav-link:hover, .nav-link.active {
                color: #2563eb !important;
                background-color: #f1f5f9;
            }

        .footer-dark {
            background-color: #0f172a;
            color: #94a3b8;
        }

        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .footer-link:hover {
                color: #ffffff;
            }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light navbar-glass py-2 shadow-sm">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark fs-5" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon shadow-sm">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <span>Alma<span class="text-primary">Vault</span></span>
                </a>

                <!-- Mobile Toggler -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Content -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                           
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="PendingApprovals">
                                        <i class="bi bi-check2-circle me-1"></i> Approvals
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="StudentDashboard">
                                        <i class="bi bi-grid-1x2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="AlumniDirectory">
                                        <i class="bi bi-people me-1"></i> Alumni Directory
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Authentication / Profile Actions -->
                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = currentUser?.FullName ?? User.Identity?.Name;
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2"
                                        type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-6"></i>
                                    <span>@displayName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userMenu">
                                    <li>
                                        <span class="dropdown-item-text text-muted small">Signed in as <strong>@User.Identity?.Name</strong></span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="Identity" asp-action="StudentLogout" asp-controller="Student" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 fw-semibold">
                                                <i class="bi bi-box-arrow-right"></i> Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Admin" asp-action="Login" class="btn btn-link text-decoration-none text-secondary fw-semibold px-3">
                                Log In
                            </a>
                            <a asp-controller="Student" asp-action="Register" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                Get Started
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer class="footer-dark mt-auto py-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon">
                            <i class="bi bi-mortarboard-fill fs-5"></i>
                        </span>
                        <span class="fs-4 fw-bold text-white">AlmaVault</span>
                    </div>
                    <p class="small text-secondary pe-lg-5 mb-3">
                        Empowering institutional growth by connecting active students with verified alumni for career mentorship, referrals, and academic networking.
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <a href="#" class="footer-link fs-5"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="footer-link fs-5"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-link fs-5"><i class="bi bi-github"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Quick Navigation</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-link">Home Portal</a></li>
                        <li><a asp-controller="Student" asp-action="Register" class="footer-link">Student Registration</a></li>
                        <li><a asp-controller="Admin" asp-action="Login" class="footer-link">Administrative Access</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-white fw-bold mb-3">Security & Integrity</h6>
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                        <p class="small text-secondary mb-0">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            All accounts are matched against institutional databases for verification before accessing directory features.
                        </p>
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4">

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; @DateTime.Now.Year AlmaVault System. All rights reserved.</p>
                <div class="d-flex gap-3 mt-2 mt-sm-0">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a>
                    <a href="#" class="footer-link">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>