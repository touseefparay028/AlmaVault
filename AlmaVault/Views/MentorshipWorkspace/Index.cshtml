@model AlmaVault.Models.ViewModel.MentorshipWorkspaceVM

@{
    ViewData["Title"] = "Mentorship Workspace";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-2">@Model.Status Mentorship</span>
            <h2 class="fw-bold mb-1">@Model.Title</h2>
            <p class="text-muted mb-0">
                Working with <strong>@Model.PartnerName</strong> (@Model.PartnerRole) —
                <a href="mailto:@Model.PartnerEmail" class="text-decoration-none">@Model.PartnerEmail</a>
            </p>
        </div>
        @if (Model.Status == "Approved")
        {
            <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#completeModal">
                <i class="bi bi-check-circle me-1"></i> Complete Mentorship
            </button>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Action Items / Tasks Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-check2-square text-primary me-2"></i>Tasks</h5>
                        <span class="badge bg-light text-dark">
                            @Model.Tasks.Count(t => t.IsCompleted) / @Model.Tasks.Count Completed
                        </span>
                    </div>

                    @* @if (Model.IsUserMentor && Model.Status == "Approved")
                    {
                        <form asp-action="AddTask" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@Model.RequestId" />
                            <div class="input-group">
                                <input type="text"asp-for="TaskItem.Description" name="description" class="form-control" placeholder="Assign task (e.g. Update resume section X)..." required />
                                <button type="submit" class="btn btn-primary px-3"><i class="bi bi-plus-lg me-1"></i> Add Task</button>
                            </div>
                        </form>
                    } *@

                    <div class="list-group list-group-flush">
                        @if (!Model.Tasks.Any())
                        {
                            <p class="text-muted small my-3">No tasks assigned yet.</p>
                        }
                        else
                        {
                            @foreach (var task in Model.Tasks)
                            {
                                <div class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between border-0">
                                    <!-- Toggle Checkbox & Task Description Form -->
                                    <form asp-action="ToggleTaskStatus" method="post" class="d-flex align-items-center flex-grow-1 me-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@task.Id" />
                                        <input type="hidden" name="requestId" value="@Model.RequestId" />
                                        <input type="checkbox" class="form-check-input me-3 mt-0" @(task.IsCompleted ? "checked" : "") onchange="this.form.submit()" />
                                        <span class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-medium")">
                                            @task.Description
                                        </span>
                                        <span class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-medium")">
                                            @task.DueDate
                                        </span>

                                    </form>

                                    <!-- Date Badge & Actions -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-muted fw-normal small">@task.CreatedAt.ToString("MMM dd")</span>

                                        @if (Model.IsUserMentor && Model.Status == "Approved")
                                        {
                                            <!-- Edit Button (Triggers Modal) -->
                                            <button type="button" class="btn btn-link text-secondary p-0 border-0" data-bs-toggle="modal" data-bs-target="#editTaskModal-@task.Id" title="Edit Task">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <!-- Delete Form Button -->
                                            <form asp-action="DeleteTask" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="taskId" value="@task.Id" />
                                                <input type="hidden" name="requestId" value="@Model.RequestId" />
                                                <button type="submit" class="btn btn-link text-danger p-0 border-0 ms-1" title="Delete Task">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                            <!-- Edit Task Modal -->
                                            <div class="modal fade" id="editTaskModal-@task.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <form asp-action="EditTask" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="taskId" value="@task.Id" />
                                                            <input type="hidden" name="requestId" value="@Model.RequestId" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fs-6 fw-bold">Edit Task</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label small text-muted">Task Description</label>
                                                                    <input type="text" name="description" class="form-control" value="@task.Description" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Notes Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-journal-text text-primary me-2"></i> Shared Notes & Resources
                    </h5>

                    @if (Model.Status == "Approved")
                    {
                        <form asp-action="AddNote" asp-controller="MentorshipWorkspace" method="post" enctype="multipart/form-data" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RequestId" value="@Model.RequestId" />

                            <div class="mb-2">
                                <textarea name="Content" class="form-control" rows="3" placeholder="Add meeting notes, advice, or attach a PDF guide..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <label for="pdfUpload" class="btn btn-outline-secondary btn-sm rounded-pill px-3 cursor-pointer">
                                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i> Attach PDF
                                    </label>
                                    <input type="file" id="pdfUpload" name="PdfFile" accept=".pdf" class="d-none" onchange="updateFileName(this)" />
                                    <span id="fileNameDisplay" class="small text-muted ms-2"></span>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">Post Note</button>
                            </div>
                        </form>
                    }

                    <div class="vstack gap-3">
                        @if (!Model.Notes.Any())
                        {
                            <p class="text-muted small">No notes or PDF resources posted yet.</p>
                        }
                        else
                        {
                            @foreach (var note in Model.Notes)
                            {
                                <div class="bg-light rounded-3 p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="small">@note.AuthorName</strong>
                                        <strong class="small">@note.Content</strong>
                                        <span class="text-muted small">@note.CreatedAt.ToString("MMM dd, h:mm tt")</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(note.Content))
                                    {
                                        <p class="mb-2 small text-secondary">@note.Content</p>
                                    }

                                    @if (note.HasAttachment)
                                    {
                                        <div class="mt-2 pt-2 border-top">
                                            <a asp-action="DownloadPdf" asp-route-noteId="@note.Id" class="btn btn-white btn-sm border rounded-pill text-dark text-decoration-none shadow-sm">
                                                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>
                                                @note.OriginalFileName
                                                <i class="bi bi-download ms-2 text-muted"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <script>
            function updateFileName(input) {
                const display = document.getElementById('fileNameDisplay');
                if (input.files && input.files[0]) {
                    display.textContent = input.files[0].name;
                } else {
                    display.textContent = '';
                }
            }
        </script>
    </div>
</div>

<!-- Complete & Feedback Modal -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="CompleteMentorship" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.RequestId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Complete Mentorship</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Marking this mentorship as complete frees up capacity for new engagements.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating (1 - 5 Stars)</label>
                        <select name="rating" class="form-select" required>
                            <option value="5">5 ★★★★★ - Excellent Guidance</option>
                            <option value="4">4 ★★★★☆ - Very Helpful</option>
                            <option value="3">3 ★★★☆☆ - Good</option>
                            <option value="2">2 ★★☆☆☆ - Fair</option>
                            <option value="1">1 ★☆☆☆☆ - Poor</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thank You Note / Review</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience or express appreciation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Complete & Save Feedback</button>
                </div>
            </form>
        </div>
    </div>
</div>