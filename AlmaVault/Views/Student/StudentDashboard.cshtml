@model AlmaVault.Models.Domains.ApplicationUser

@{
    ViewData["Title"] = "Student Dashboard";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 20px;
    }

    .stat-card {
        border: 1px solid rgba(226, 232, 240, 0.8);
        transition: all 0.25s ease-in-out;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
        }

    .action-card {
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

        .action-card:hover {
            border-color: #2563eb;
            background-color: #f8fafc;
        }

    .avatar-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #1e293b;
    }
</style>

<div class="container py-4">

    <!-- 1. HERO WELCOME BANNER -->
    <div class="dashboard-hero text-white p-4 p-lg-5 mb-4 shadow-sm position-relative overflow-hidden">
        <div class="row align-items-center position-relative z-1">
            <div class="col-lg-8">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold">
                    <i class="bi bi-patch-check-fill me-1"></i> Verified Student Member
                </span>
                <h1 class="fw-bold display-6 mb-2">Welcome back, @Model.FullName!</h1>
                <p class="text-secondary mb-3 fs-6">
                    Department: <strong class="text-light">@(Model.Department ?? "Computer Science")</strong> | Roll No: <strong class="text-light">@Model.RollNumber</strong>
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="#alumni-section" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-search me-1"></i> Find Alumni Mentors
                    </a>
                    <a href="#jobs-section" class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                        <i class="bi bi-briefcase me-1"></i> View Referral Board
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-end">
                <i class="bi bi-mortarboard text-white opacity-10" style="font-size: 9rem;"></i>
            </div>
        </div>
    </div>

    <!-- 2. METRICS & OVERVIEW CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 me-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">Verified Alumni</span>
                        <h3 class="fw-bold mb-0">@(ViewBag.VerifiedAlumniCount ?? "120+")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-success-subtle text-success rounded-3 me-3">
                        <i class="bi bi-briefcase-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">Active Referrals</span>
                        <h3 class="fw-bold mb-0">@(ViewBag.ActiveJobPostings ?? "18")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 me-3">
                        <i class="bi bi-chat-left-text-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">My Outreach</span>
                        <h3 class="fw-bold mb-0">3 Requests</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-info-subtle text-info rounded-3 me-3">
                        <i class="bi bi-calendar-check-fill fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">Mentorship Sessions</span>
                        <h3 class="fw-bold mb-0">2 Scheduled</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MAIN DASHBOARD CONTENT GRID -->
    <div class="row g-4">

        <!-- LEFT COLUMN: ALUMNI DIRECTORY & JOBS BOARD -->
        <div class="col-lg-8">

            <!-- SECTION A: ALUMNI MENTOR FINDER -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4" id="alumni-section">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Verified Alumni Network</h5>
                        <small class="text-muted">Connect directly with graduates working in top industries.</small>
                    </div>
                    <a asp-action="AlumniDirectory" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold">
                        View All Directory <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <!-- Search & Filters -->
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-light border-start-0" placeholder="Search by name, company, or role...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select form-select-sm bg-light">
                            <option selected>All Departments</option>
                            <option>Computer Science</option>
                            <option>Information Technology</option>
                            <option>Electronics & Comm.</option>
                            <option>Mechanical Eng.</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary btn-sm w-100 rounded-3 fw-semibold">Filter</button>
                    </div>
                </div>

                <!-- Featured Alumni List -->
                <div class="list-group list-group-flush border-top">

                    <!-- Alumni Item 1 -->
                    <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle">
                                <span>AK</span>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">Aamir Khan</h6>
                                <p class="small text-muted mb-0">Software Engineer at Microsoft | Batch 2023</p>
                                <span class="badge bg-light text-dark border me-1">CSE</span>
                                <span class="badge bg-success-subtle text-success">Open for Mentorship</span>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#connectModal" data-alumni="Aamir Khan">
                            <i class="bi bi-send me-1"></i> Connect
                        </button>
                    </div>

                    <!-- Alumni Item 2 -->
                    <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-circle bg-info-subtle text-info">
                                <span>SR</span>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">Saba Rashid</h6>
                                <p class="small text-muted mb-0">Product Manager at Amazon | Batch 2021</p>
                                <span class="badge bg-light text-dark border me-1">IT</span>
                                <span class="badge bg-primary-subtle text-primary">Referrals Offered</span>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#connectModal" data-alumni="Saba Rashid">
                            <i class="bi bi-send me-1"></i> Connect
                        </button>
                    </div>

                </div>
            </div>

            <!-- SECTION B: JOB & REFERRAL BOARD -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" id="jobs-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Alumni Job & Referral Opportunities</h5>
                        <small class="text-muted">Direct job openings shared by institutional graduates.</small>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- Job Card 1 -->
                    <div class="col-md-6">
                        <div class="card action-card rounded-3 p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-semibold">Full Time</span>
                                <small class="text-muted">Posted 2 days ago</small>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Junior .NET Developer</h6>
                            <p class="small text-muted mb-2">TechCorp Solutions • Srinagar / Remote</p>
                            <p class="small text-secondary mb-3">Looking for fresh graduates proficient in C#, ASP.NET Core MVC, and SQL Server.</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <small class="text-muted">Posted by: <strong>Zahid Parray</strong></small>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">Apply / Request Referral</button>
                            </div>
                        </div>
                    </div>

                    <!-- Job Card 2 -->
                    <div class="col-md-6">
                        <div class="card action-card rounded-3 p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-success-subtle text-success fw-semibold">Internship</span>
                                <small class="text-muted">Posted 4 days ago</small>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Frontend UI/UX Intern</h6>
                            <p class="small text-muted mb-2">CloudScale Systems • Hybrid</p>
                            <p class="small text-secondary mb-3">3-month stipend internship with opportunity for full-time conversion based on performance.</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <small class="text-muted">Posted by: <strong>Saba Rashid</strong></small>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">Apply / Request Referral</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: SIDEBAR & STUDENT PROFILE -->
        <div class="col-lg-4">

            <!-- CARD 1: STUDENT PROFILE BADGE -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-3">Student Identity Summary</h6>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="avatar-circle bg-primary text-white fs-4">
                        @Model.UserName?.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">@Model.FullName</h6>
                        <small class="text-muted d-block">@Model.Email</small>
                    </div>
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Roll Number:</span>
                        <strong class="text-dark">@Model.RollNumber</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Department:</span>
                        <strong class="text-dark">@(Model.Department ?? "Computer Science")</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Portal Verification:</span>
                        <span class="badge bg-success-subtle text-success">Verified Active</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Member Since:</span>
                        <strong class="text-dark">@Model.CreatedAt.ToString("MMM yyyy")</strong>
                    </li>
                </ul>
            </div>

            <!-- CARD 2: UPCOMING EVENTS & SESSIONS -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Upcoming Sessions</h6>
                    <span class="badge bg-warning-subtle text-warning-emphasis">Live Webinars</span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-2 border-start border-primary border-4">
                    <h6 class="fw-bold mb-1 small text-dark">Resume & Portfolio Masterclass</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-clock me-1"></i> Saturday, 5:00 PM</p>
                    <small class="text-primary fw-semibold">Speaker: Microsoft Alumni Team</small>
                </div>

                <div class="p-3 bg-light rounded-3 border-start border-success border-4">
                    <h6 class="fw-bold mb-1 small text-dark">Cracking Tech Interviews 101</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-clock me-1"></i> Next Tuesday, 6:30 PM</p>
                    <small class="text-success fw-semibold">Speaker: Amazon Alumni Network</small>
                </div>
            </div>

            <!-- CARD 3: SYSTEM ANNOUNCEMENTS -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-megaphone me-2 text-primary"></i> Campus Announcements</h6>
                <p class="small text-muted mb-2">
                    <strong>Annual Alumni Meet 2026:</strong> Registration for student volunteers is now open. Reach out via the Admin portal.
                </p>
                <hr class="my-2">
                <p class="small text-muted mb-0">
                    <strong>Verification Notice:</strong> Ensure your registered department matches your university ID records.
                </p>
            </div>

        </div>
    </div>
</div>

<!-- OUTREACH / CONNECT MODAL -->
<div class="modal fade" id="connectModal" tabindex="-1" aria-labelledby="connectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="connectModalLabel">Initiate Mentorship Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="small text-muted mb-3">Send a structured message to connect for career advice, mentorship, or job referral inquiry.</p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Request Topic</label>
                    <select class="form-select form-select-sm">
                        <option selected>General Mentorship & Career Guidance</option>
                        <option>Job / Internship Referral Inquiry</option>
                        <option>Resume & Portfolio Review</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Personalized Message</label>
                    <textarea class="form-control" rows="4" placeholder="Introduce yourself, mention your course, and share what guidance you are seeking..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold">Send Request</button>
            </div>
        </div>
    </div>
</div>