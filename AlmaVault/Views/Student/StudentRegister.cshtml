@model AlmaVault.Models.ViewModel.StudentRegisterVM

@{
    ViewData["Title"] = "Student Registration";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">AlmaVault Student Registration</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="RegisterStudent" asp-controller="Student" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Jane Doe" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RollNumber" class="form-label fw-semibold"></label>
                            <input asp-for="RollNumber" class="form-control" placeholder="e.g. CS2024-001" />
                            <span asp-validation-for="RollNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="student@university.edu" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <input asp-for="Department" class="form-control" placeholder="Computer Science" />
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Create Student Account</button>
                        </div>
                    </form>
                    <!-- Footer Link -->
                    <div class="card-footer bg-light text-center py-3 border-0">
                        <span class="small text-muted">Do you have an account?</span>
                        <a asp-action="StudentLogin" asp-controller="Student" class="small fw-bold text-primary text-decoration-none ms-1">Login Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}