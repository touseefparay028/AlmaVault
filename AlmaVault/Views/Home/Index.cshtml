@{
    ViewData["Title"] = "AlmaVault - Bridge the Gap Between Students & Alumni";
}

<!-- Custom Styles for Modern Polish -->
<style>
    .hero-gradient {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
    }

    .text-gradient {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
        }

    .icon-box {
        width: 60px;
        height: 60px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
    }
</style>

<!-- 1. Hero Section -->
<section class="hero-gradient text-white py-5 py-lg-6 position-relative overflow-hidden">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3 fw-semibold fs-6">
                    <i class="bi bi-stars me-1"></i> Next-Gen Institutional Network
                </span>
                <h1 class="display-4 fw-bold lh-sm mb-3">
                    Connect Campus <span class="text-gradient">Ambition</span> with Global <span class="text-gradient">Experience</span>
                </h1>
                <p class="lead text-light opacity-75 mb-4">
                    AlmaVault bridges current students, verified alumni, and campus administration into one seamless, secure ecosystem for career mentorship and job referrals.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Student" asp-action="StudentRegister" class="btn btn-primary btn-lg px-4 py-3 fw-bold shadow-lg">
                        <i class="bi bi-mortarboard-fill me-2"></i> Join as Student
                    </a>
                    <a asp-controller="Admin" asp-action="Login" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                        <i class="bi bi-shield-lock-fill me-2"></i> Admin Portal
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass-card p-4 rounded-4 shadow-lg">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-4 rounded-3 bg-white bg-opacity-10 text-white text-center">
                                <h2 class="display-6 fw-bold mb-1 text-gradient">100%</h2>
                                <small class="text-uppercase tracking-wider opacity-75">Verified Alumni</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-4 rounded-3 bg-white bg-opacity-10 text-white text-center">
                                <h2 class="display-6 fw-bold mb-1 text-gradient">1-on-1</h2>
                                <small class="text-uppercase tracking-wider opacity-75">Direct Mentorship</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-4 rounded-3 bg-white bg-opacity-10 text-white">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                    <span class="fw-bold">Institutional Validation</span>
                                </div>
                                <p class="small text-light opacity-75 mb-0">
                                    Historical student database verification ensures every connection is authentic and identity-proofed.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. Portal Access Gateway -->
<section class="py-5 bg-light">
    <div class="container py-4">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <h2 class="fw-bold display-6 mb-2">Select Your Portal</h2>
            <p class="text-muted fs-5">Tailored environments built specifically for every member of our academic community.</p>
        </div>

        <div class="row g-4">
            <!-- Student Card -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="icon-box bg-primary-subtle text-primary mb-4">
                        <i class="bi bi-mortarboard fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Current Students</h4>
                    <p class="text-muted mb-4">
                        Search verified alumni by department or current company, request career mentorship, and apply for exclusive job opportunities.
                    </p>
                    <div class="mt-auto">
                        <a asp-controller="Student" asp-action="StudentRegister" class="btn btn-outline-primary w-100 fw-bold py-2 rounded-3">
                            Student Sign Up <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Alumni Card -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="icon-box bg-success-subtle text-success mb-4">
                        <i class="bi bi-briefcase fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Institutional Alumni</h4>
                    <p class="text-muted mb-4">
                        Give back to your alma mater by hosting mentorship sessions, posting open roles at your company, and networking with peers.
                    </p>
                    <div class="mt-auto">
                        <a asp-controller="Alumni" asp-action="AlumniRegister" class="btn btn-outline-success w-100 fw-bold py-2 rounded-3">
                            Alumni Portal <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Admin Card -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-lift">
                    <div class="icon-box bg-dark text-white mb-4">
                        <i class="bi bi-shield-check fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Campus Administration</h4>
                    <p class="text-muted mb-4">
                        Review alumni registration credentials, audit historical student records, manage system access roles, and monitor engagement metrics.
                    </p>
                    <div class="mt-auto">
                        <a asp-controller="Admin" asp-action="AdminRegister" class="btn btn-dark w-100 fw-bold py-2 rounded-3">
                            Admin Access <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. Key Platform Pillars -->
<section class="py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="badge bg-primary text-white px-3 py-2 rounded-pill mb-3">Enterprise Core</span>
                <h2 class="fw-bold display-6 mb-3">Designed for Security, Speed, and Trust</h2>
                <p class="text-muted mb-4">
                    AlmaVault integrates ASP.NET Core Identity with automated institutional verification to ensure a trusted, fraud-free environment for students and graduates alike.
                </p>

                <div class="d-flex mb-3">
                    <div class="me-3 text-primary">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Role-Based Access Control</h6>
                        <p class="small text-muted">Strict permission isolation between Students, Alumni, and Administrative roles.</p>
                    </div>
                </div>

                <div class="d-flex mb-3">
                    <div class="me-3 text-primary">
                        <i class="bi bi-database-check fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Historical Record Matching</h6>
                        <p class="small text-muted">Automated validation against verified institutional database archives.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-4 bg-light rounded-4 border-0 mb-3">
                            <i class="bi bi-people text-primary fs-1 mb-3 d-block"></i>
                            <h5 class="fw-bold">Alumni Directory</h5>
                            <p class="small text-muted mb-0">Search and filter graduates by current company, industry domain, location, and department.</p>
                        </div>
                        <div class="p-4 bg-light rounded-4 border-0">
                            <i class="bi bi-patch-check text-success fs-1 mb-3 d-block"></i>
                            <h5 class="fw-bold">Credential Verification</h5>
                            <p class="small text-muted mb-0">Document review workflows for identity proofing and instant admin approval queues.</p>
                        </div>
                    </div>
                    <div class="col-md-6 mt-md-5">
                        <div class="p-4 bg-light rounded-4 border-0 mb-3">
                            <i class="bi bi-briefcase text-warning fs-1 mb-3 d-block"></i>
                            <h5 class="fw-bold">Referral Board</h5>
                            <p class="small text-muted mb-0">Direct job and internship postings submitted exclusively by verified alumni network members.</p>
                        </div>
                        <div class="p-4 bg-light rounded-4 border-0">
                            <i class="bi bi-calendar2-event text-danger fs-1 mb-3 d-block"></i>
                            <h5 class="fw-bold">Mentorship Sessions</h5>
                            <p class="small text-muted mb-0">Schedule 1-on-1 advisory sessions with industry experts from your alma mater.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. Call to Action Banner -->
<section class="py-5 bg-dark text-white text-center position-relative">
    <div class="container py-4">
        <h2 class="display-6 fw-bold mb-3">Ready to Connect Your Institutional Community?</h2>
        <p class="lead opacity-75 max-w-2xl mx-auto mb-4">
            Join thousands of students and graduates already collaborating through AlmaVault.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Student" asp-action="Register" class="btn btn-primary btn-lg px-5 fw-bold rounded-3">Get Started Today</a>
        </div>
    </div>
</section>