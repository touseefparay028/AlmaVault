@model AlmaVault.Models.ViewModel.MentorshipDetailsVM

@{
    ViewData["Title"] = "Mentorship Request Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>Mentorship Request Details
                    </h4>
                    <a asp-controller="Alumni" asp-action="AlumniDashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>

                <!-- Mentee Profile Details -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold">Mentee Name</label>
                        <p class="fw-bold mb-0">
                            @Model.MenteeCard.FullName
                            @if (Model.MenteeCard.IsVerified)
                            {
                                <i class="bi bi-patch-check-fill text-primary ms-1" title="Verified"></i>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold">Mentee Email</label>
                        <p class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.MenteeCard.Email))
                            {
                                <a href="mailto:@Model.MenteeCard.Email" class="text-decoration-none">@Model.MenteeCard.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.MenteeCard.Department))
                    {
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Department</label>
                            <p class="mb-0">@Model.MenteeCard.Department</p>
                        </div>
                    }
                    @if (Model.MenteeCard.GraduationYear > 0)
                    {
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Graduation Year</label>
                            <p class="mb-0">@Model.MenteeCard.GraduationYear</p>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold">Requested Date</label>
                        <p class="mb-0">@Model.RequestedDate.ToString("MMMM dd, yyyy - hh:mm tt")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold">Status</label>
                        <div>
                            @if (Model.Status == "Approved")
                            {
                                <span class="badge bg-success-subtle text-success fs-6">Approved</span>
                            }
                            else if (Model.Status == "Rejected")
                            {
                                <span class="badge bg-danger-subtle text-danger fs-6">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning fs-6">Pending</span>
                            }
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Request Content -->
                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Topic / Title</label>
                    <h5 class="fw-bold text-dark">@Model.Title</h5>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Student's Note / Message</label>
                    <div class="p-3 bg-light rounded-3 text-secondary" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Note) ? "No detailed message provided." : Model.Note)
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end align-items-center gap-2 flex-wrap pt-2 border-top">
                    <a asp-action="Index" asp-controller="MentorshipWorkspace" asp-route-id="@Model.RequestId" class="btn btn-primary">
                        Tasks & Notes
                    </a>
                    <button type="button" class="btn btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addTaskModal">
                        <i class="bi bi-check2-square me-1"></i> Add Task
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addNoteModal">
                        <i class="bi bi-journal-plus me-1"></i> Add Note
                    </button>
                    @if (!string.IsNullOrEmpty(Model.MenteeCard.Email))
                    {
                        <a href="mailto:@Model.MenteeCard.Email" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-envelope me-1"></i> Send Email
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Task Modal -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addTaskModalLabel">
                    <i class="bi bi-check2-square text-primary me-2"></i>Assign New Task
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="MentorshipWorkspace" asp-action="AddTask" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RequestId" />
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Task Title</label>
                        <input asp-for="TaskItem.Title" class="form-control rounded-3" placeholder="e.g., Complete System Design draft" />
                        <span asp-validation-for="TaskItem.Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea asp-for="TaskItem.Description" class="form-control rounded-3" rows="3" placeholder="Provide instructions for the mentee..."></textarea>
                        <span asp-validation-for="TaskItem.Description" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Due Date</label>
                        <input asp-for="TaskItem.DueDate" type="date" class="form-control rounded-3" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Assign Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Note Modal -->
<div class="modal fade" id="addNoteModal" tabindex="-1" aria-labelledby="addNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addNoteModalLabel">
                    <i class="bi bi-journal-plus text-secondary me-2"></i>Attach Note / Resource PDF
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Mentorship" asp-action="AddNote" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RequestId" />
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">PDF Attachment</label>
                        <input asp-for="NewNote.PdfFile" type="file" accept=".pdf" class="form-control rounded-3" />
                        <span asp-validation-for="NewNote.PdfFile" class="text-danger small"></span>
                        <div class="form-text">Only PDF files are accepted.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-secondary rounded-pill px-4">Upload Note</button>
                </div>
            </form>
        </div>
    </div>
</div>