@model IEnumerable<AlmaVault.Models.ViewModel.MentorshipRequestsVM.MentorCardViewModel>

@{
    ViewData["Title"] = "Browse Mentors";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Find an Alumni Mentor</h2>
            <p class="text-muted mb-0">Connect with experienced alumni for career guidance, referrals, and advice.</p>
        </div>
        <a asp-action="StudentRequests" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-clock-history me-1"></i> My Sent Requests
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Bar -->
    <form method="get" asp-action="Browse" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" class="form-control form-control-lg rounded-start-pill ps-4"
                   placeholder="Search by name, company, or department..." value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn btn-primary rounded-end-pill px-4">
                <i class="bi bi-search me-1"></i> Search
            </button>
        </div>
    </form>

    <!-- Mentors Cards List -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-people fs-1 text-muted d-block mb-2"></i>
                <h5 class="text-muted">No mentors found matching your criteria.</h5>
            </div>
        }
        else
        {
            @foreach (var mentor in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary-subtle text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width: 50px; height: 50px; font-size: 1.2rem;">
                                    @mentor.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0">@mentor.FullName</h5>
                                    <span class="small text-muted">@mentor.Designation at @mentor.CurrentCompany</span>
                                </div>
                            </div>

                            

                            <div class="border-top pt-3 mt-auto d-flex align-items-center justify-content-between">
                                <span class="badge bg-light text-dark fw-normal">Class of @mentor.GraduationYear</span>
                                @if (mentor.HasPendingRequest)
                                {
                                    <button class="btn btn-sm btn-secondary rounded-pill disabled" disabled>Request Active</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3"
                                            data-bs-toggle="modal" data-bs-target="#requestModal-@mentor.Id">
                                        Request Guidance
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal for Sending Request -->
                <div class="modal fade" id="requestModal-@mentor.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0 shadow">
                            <form asp-action="SendRequest" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MentorId" value="@mentor.Id" />

                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Request Mentorship from @mentor.FullName</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Topic / Title</label>
                                        <input type="text" name="Title" class="form-control" placeholder="e.g. Resume Review or Software Engineering Advice" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Message / Context</label>
                                        <textarea name="Note" class="form-control" rows="4" placeholder="Briefly introduce yourself and what specific guidance you are seeking..." required></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Send Request</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>