@model AlmaVault.Models.ViewModel.CreateCampaignVM
@using AlmaVault.Models.Domains

@{
    ViewData["Title"] = "Create New Campaign";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <h3 class="fw-bold text-dark">Create Campaign</h3>
                        <p class="text-muted small">Launch a new fundraising or resource campaign for alumni contributions.</p>
                    </div>

                    <form asp-action="CampaignCreate" asp-controller="Contribution" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold text-secondary">Campaign Title</label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="e.g., Computer Lab Hardware Drive 2026" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold text-secondary">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Describe the purpose, target beneficiaries, and impact of this campaign..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <!-- Type -->
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-semibold text-secondary">Campaign Type</label>
                                <select asp-for="Type" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<CampaignType>()">
                                    <option value="">Select Category</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <!-- Target Amount -->
                            <div class="col-md-6">
                                <label asp-for="TargetAmount" class="form-label fw-semibold text-secondary">Target Goal ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold">$</span>
                                    <input asp-for="TargetAmount" type="number" step="0.01" class="form-control rounded-end-3" placeholder="50000.00" />
                                </div>
                                <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Beneficiary Department -->
                            <div class="col-md-6">
                                <label asp-for="BeneficiaryDepartment" class="form-label fw-semibold text-secondary">Beneficiary Department</label>
                                <input asp-for="BeneficiaryDepartment" class="form-control rounded-3" placeholder="e.g., Computer Science & IT" />
                                <span asp-validation-for="BeneficiaryDepartment" class="text-danger small"></span>
                            </div>

                            <!-- End Date -->
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold text-secondary">Campaign End Date (Optional)</label>
                                <input asp-for="EndDate" class="form-control rounded-3" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill px-4">
                                Launch Campaign
                            </button>
                            <a asp-controller="Contribution" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}