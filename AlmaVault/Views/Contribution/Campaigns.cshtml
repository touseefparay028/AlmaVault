@model AlmaVault.Models.ViewModel.CampaignDirectoryVM

<div class="container py-4">
    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-1">Welcome Back, Donor</h5>
                <p class="card-text text-muted mb-0">Total Lifetime Giving: <strong>$@Model.DonorSummary.TotalLifetimeGiving.ToString("N2")</strong></p>
            </div>
            <div>
                <span class="badge @Model.DonorSummary.BadgeCssClass fs-6 px-3 py-2">@Model.DonorSummary.TierName</span>
                <a asp-action="Dashboard" class="btn btn-outline-dark btn-sm ms-2">Personal Dashboard</a>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-3">Active Campaigns</h3>

    <div class="row g-4">
        @if (Model.ActiveCampaigns != null && Model.ActiveCampaigns.Any())
        {
            @foreach (var c in Model.ActiveCampaigns)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary">@c.Category</span>
                                <small class="text-muted">@c.BeneficiaryDepartment</small>
                            </div>
                            <h5 class="card-title fw-bold">@c.Title</h5>
                            <p class="card-text text-muted flex-grow-1">@c.Description</p>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Raised: $@c.CurrentAmount.ToString("N0")</span>
                                    <span>Goal: $@c.TargetAmount.ToString("N0")</span>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @(c.ProgressPercentage)%" aria-valuenow="@c.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <a asp-action="Donate" asp-route-campaignId="@c.Id" class="btn btn-primary w-100 fw-bold">Support Campaign</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-4 bg-light rounded-3 border">
                    <i class="bi bi-megaphone display-4 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">No Active Campaigns</h5>
                    <p class="text-muted mb-0">There are currently no active fundraising campaigns. Please check back later!</p>
                </div>
            </div>
        }
    </div>
</div>