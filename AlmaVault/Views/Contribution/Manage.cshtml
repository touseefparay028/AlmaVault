@model IEnumerable<AlmaVault.Models.ViewModel.ManageCampaignListItemVM>

@{
    ViewData["Title"] = "Campaign Management";

    var totalCampaigns = Model.Count();
    var activeCampaigns = Model.Count(c => c.IsActive);
    var totalRaised = Model.Sum(c => c.CurrentAmount);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Campaign Management</h3>
            <p class="text-muted small mb-0">Overview of all active and archived university contribution drives.</p>
        </div>
        <div>
            <a asp-action="CreateCampaign" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create Campaign
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle p-3 me-3">
                        <i class="bi bi-megaphone fs-4 text-primary"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold">Total Campaigns</span>
                        <h4 class="fw-bold mb-0 text-dark">@totalCampaigns</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 me-3">
                        <i class="bi bi-activity fs-4 text-success"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold">Active Drives</span>
                        <h4 class="fw-bold mb-0 text-dark">@activeCampaigns</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info-subtle p-3 me-3">
                        <i class="bi bi-currency-dollar fs-4 text-info"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold">Total Funds Raised</span>
                        <h4 class="fw-bold mb-0 text-dark">$@totalRaised.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Campaigns Table Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Campaign Details</th>
                            <th class="py-3">Category / Dept</th>
                            <th class="py-3">Progress</th>
                            <th class="py-3">Donors</th>
                            <th class="py-3">Status</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Title & End Date -->
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark mb-0">@item.Title</div>
                                        <small class="text-muted">
                                            @(item.EndDate.HasValue ? $"Ends: {item.EndDate.Value:MMM dd, yyyy}" : "No End Date")
                                        </small>
                                    </td>

                                    <!-- Category & Dept -->
                                    <td class="py-3">
                                        <span class="badge bg-secondary-subtle text-secondary fw-semibold px-2 py-1 rounded-2 mb-1 d-inline-block">
                                            @item.Type
                                        </span>
                                        <div class="small text-muted">
                                            @(string.IsNullOrEmpty(item.BeneficiaryDepartment) ? "General" : item.BeneficiaryDepartment)
                                        </div>
                                    </td>

                                    <!-- Progress & Amounts -->
                                    <td class="py-3" style="min-width: 180px;">
                                        <div class="d-flex justify-content-between small fw-semibold mb-1">
                                            <span class="text-dark">$@item.CurrentAmount.ToString("N0")</span>
                                            <span class="text-muted">Goal: $@item.TargetAmount.ToString("N0")</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @(item.ProgressPercentage)%"
                                                 aria-valuenow="@item.ProgressPercentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"></div>
                                        </div>
                                        <small class="text-muted">@item.ProgressPercentage% funded</small>
                                    </td>

                                    <!-- Donors -->
                                    <td class="py-3">
                                        <span class="fw-bold text-dark">@item.TotalDonorsCount</span>
                                        <span class="small text-muted">donors</span>
                                    </td>

                                    <!-- Status -->
                                    <td class="py-3">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-circle-fill fs-8 me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-circle-fill fs-8 me-1"></i> Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <!-- Edit -->
                                            <a asp-action="EditCampaign" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2" title="Edit Campaign">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>

                                            <!-- Toggle Status -->
                                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-2" title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(item.IsActive ? "bi-pause-circle-fill" : "bi-play-circle-fill")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No campaigns found. Click "Create Campaign" to add one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>