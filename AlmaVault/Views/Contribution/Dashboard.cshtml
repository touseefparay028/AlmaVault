@model AlmaVault.Models.ViewModel.DonorImpactSummaryVM

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted text-uppercase fw-bold">Lifetime Giving</small>
                <h2 class="fw-bold text-success mb-0">$@Model.TotalLifetimeGiving.ToString("N2")</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted text-uppercase fw-bold">Campaigns Supported</small>
                <h2 class="fw-bold text-primary mb-0">@Model.CampaignsSupportedCount</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <small class="text-muted text-uppercase fw-bold">Donor Tier</small>
                <div>
                    <span class="badge @Model.BadgeCssClass fs-5 mt-1">@Model.TierName</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Contribution History Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Contribution History</h5>
            <a asp-action="Campaigns" asp-controller="Contribution" class="btn btn-primary btn-sm">Explore Campaigns</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Campaign</th>
                            <th>Reference</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.History.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No contributions recorded.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.History)
                            {
                                <tr>
                                    <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-semibold">@item.CampaignTitle</td>
                                    <td><code>@item.TransactionRef</code></td>
                                    <td>$@item.Amount.ToString("N2")</td>
                                    <td>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsVerified && !string.IsNullOrEmpty(item.TaxReceiptPath))
                                        {
                                            <a asp-action="DownloadReceipt" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" target="_blank">
                                                <i class="bi bi-file-earmark-pdf"></i> Receipt PDF
                                            </a>
                                        }
                                        else if (!item.IsVerified)
                                        {
                                            <span class="badge bg-warning text-dark">Pending Verification</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>